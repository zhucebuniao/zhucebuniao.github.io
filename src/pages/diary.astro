---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { CATEGORIES, getAllPosts } from '../utils/posts';

const allPosts = await getAllPosts();
const posts = allPosts.filter((p) => p.category === 'diary');
const meta = CATEGORIES.diary;
---
<BaseLayout title={meta.label} description={meta.description} pageCat="diary">
  <section class="bento-card archive-hero" style="background:radial-gradient(circle at 90% 20%, rgba(251,191,36,0.18), transparent 60%), var(--surface);">
    <div>
      <div class="intro-badge" style="margin-bottom:10px;color:var(--c-diary);border-color:rgba(251,191,36,0.3);background:rgba(251,191,36,0.12);">
        ✦ {meta.enLabel} NOTES
      </div>
      <h1 class="archive-hero-title">
        <span>{meta.icon}</span>
        <span>{meta.label} · {meta.tagline}</span>
      </h1>
      <p class="archive-hero-desc">{meta.description}</p>
    </div>
    <div style="font-family:var(--font-mono);text-align:right;">
      <div style="font-size:32px;font-weight:600;color:var(--c-diary);">{posts.length}</div>
      <div style="font-size:12px;color:var(--ink-muted);">日常手记</div>
    </div>
  </section>

  <div class="posts-grid">
    {posts.map((post) => (
      <PostCard post={post} />
    ))}
  </div>
</BaseLayout>
