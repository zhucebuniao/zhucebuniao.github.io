---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import TravelMap from '../components/TravelMap.astro';
import { CATEGORIES, getAllPosts, groupTravelsByCity } from '../utils/posts';

const allPosts = await getAllPosts();
const posts = allPosts.filter((p) => p.category === 'travel');
const citySummaries = groupTravelsByCity(allPosts);
const meta = CATEGORIES.travel;
---
<BaseLayout title={meta.label} description={meta.description} pageCat="travel">
  <section class="bento-card archive-hero" style="background:radial-gradient(circle at 90% 20%, rgba(56,189,248,0.18), transparent 60%), var(--surface);">
    <div>
      <div class="intro-badge" style="margin-bottom:10px;color:var(--c-travel);border-color:rgba(56,189,248,0.3);background:rgba(56,189,248,0.12);">
        ✦ {meta.enLabel} & FOOTPRINTS
      </div>
      <h1 class="archive-hero-title">
        <span>{meta.icon}</span>
        <span>{meta.label} · {meta.tagline}</span>
      </h1>
      <p class="archive-hero-desc">{meta.description}</p>
    </div>
    <div style="display:flex;gap:24px;font-family:var(--font-mono);text-align:right;">
      <div>
        <div style="font-size:32px;font-weight:600;color:var(--c-travel);">{citySummaries.length}</div>
        <div style="font-size:12px;color:var(--ink-muted);">漫游城市</div>
      </div>
      <div>
        <div style="font-size:32px;font-weight:600;color:var(--c-travel);">{posts.length}</div>
        <div style="font-size:12px;color:var(--ink-muted);">旅途篇章</div>
      </div>
    </div>
  </section>

  <div style="margin-bottom:32px;">
    <TravelMap cities={citySummaries} compact={false} />
  </div>

  <div class="feed-section-head">
    <h2 class="section-heading">
      <span class="sparkle" style="color:var(--c-travel);">✦</span>
      <span>按目的地筛选</span>
    </h2>
    <div class="filter-tabs" id="travel-city-filter">
      <button type="button" class="filter-tab active" data-city-filter="all">全部 ({posts.length})</button>
      {citySummaries.map((cs) => (
        <button type="button" class="filter-tab" data-city-filter={cs.city.name}>
          {cs.city.name} <span style="opacity:0.65;font-size:11px;">{cs.posts.length}</span>
        </button>
      ))}
    </div>
  </div>

  <div class="posts-grid" id="travel-posts-grid">
    {posts.map((post) => (
      <PostCard post={post} />
    ))}
  </div>

  <script is:inline>
    function initTravelCityFilter() {
      const btns = document.querySelectorAll('#travel-city-filter [data-city-filter]');
      const cards = document.querySelectorAll('#travel-posts-grid .post-card');
      if (!btns.length || !cards.length) return;

      btns.forEach((btn) => {
        if (btn.dataset.bound === 'true') return;
        btn.dataset.bound = 'true';
        btn.addEventListener('click', () => {
          const target = btn.getAttribute('data-city-filter');
          btns.forEach((b) => b.classList.remove('active'));
          btn.classList.add('active');
          cards.forEach((c) => {
            const city = c.getAttribute('data-city');
            c.classList.toggle('is-hidden', target !== 'all' && city !== target);
          });
        });
      });
    }
    initTravelCityFilter();
    document.addEventListener('astro:page-load', initTravelCityFilter);
  </script>
</BaseLayout>
