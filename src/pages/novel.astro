---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { CATEGORIES, getAllPosts } from '../utils/posts';

const allPosts = await getAllPosts();
const posts = allPosts.filter((p) => p.category === 'novel').reverse(); // chronological reading order for chapters
const meta = CATEGORIES.novel;
---
<BaseLayout title={meta.label} description={meta.description} pageCat="novel">
  <section class="bento-card archive-hero" style="background:radial-gradient(circle at 90% 20%, rgba(251,113,133,0.18), transparent 60%), var(--surface);">
    <div>
      <div class="intro-badge" style="margin-bottom:10px;color:var(--c-novel);border-color:rgba(251,113,133,0.3);background:rgba(251,113,133,0.12);">
        ✦ {meta.enLabel} SERIES
      </div>
      <h1 class="archive-hero-title">
        <span>{meta.icon}</span>
        <span>{meta.label} · 《梦见海洋的人》</span>
      </h1>
      <p class="archive-hero-desc">{meta.description}（已按章节先后顺序排列，适合从第一章读起）</p>
    </div>
    <div style="font-family:var(--font-mono);text-align:right;">
      <div style="font-size:32px;font-weight:600;color:var(--c-novel);">{posts.length}</div>
      <div style="font-size:12px;color:var(--ink-muted);">连载章节</div>
    </div>
  </section>

  <div class="posts-grid">
    {posts.map((post) => (
      <PostCard post={post} />
    ))}
  </div>
</BaseLayout>
