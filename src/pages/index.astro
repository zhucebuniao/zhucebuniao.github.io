---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import TravelMap from '../components/TravelMap.astro';
import { getAllPosts, groupTravelsByCity } from '../utils/posts';

const allPosts = await getAllPosts();
const dreams = allPosts.filter((p) => p.category === 'dream');
const travels = allPosts.filter((p) => p.category === 'travel');
const novels = allPosts.filter((p) => p.category === 'novel');
const diaries = allPosts.filter((p) => p.category === 'diary');

const latestDream = dreams[0];
const latestTravel = travels[0];
const citySummaries = groupTravelsByCity(allPosts);
---
<BaseLayout title="梦与远方">
  <!-- Bento Hero Grid -->
  <section class="bento-hero">
    <!-- Main Intro Bento Card -->
    <div class="bento-card bento-intro">
      <div>
        <div class="intro-badge">
          <span>✦</span>
          <span>COSMOS & HORIZON · 梦境与远行档案</span>
        </div>
        <h1 class="intro-title">梦与远方</h1>
        <p class="intro-subtitle">
          夜里在星群间拾起凌晨三点的梦境，白天去山海与古镇淋一场不打算躲的雨。这里存放着那些转瞬即逝的微光、风声与故事。
        </p>
      </div>

      <div class="intro-stats-grid">
        <a href="/dreams/" class="stat-pill dream">
          <span class="num">{dreams.length}</span>
          <span class="lbl"><span>梦境</span><span>🌙</span></span>
        </a>
        <a href="/travels/" class="stat-pill travel">
          <span class="num">{travels.length}</span>
          <span class="lbl"><span>游记</span><span>🧭</span></span>
        </a>
        <a href="/novel/" class="stat-pill novel">
          <span class="num">{novels.length}</span>
          <span class="lbl"><span>小说</span><span>🌊</span></span>
        </a>
        <a href="/diary/" class="stat-pill diary">
          <span class="num">{diaries.length}</span>
          <span class="lbl"><span>日记</span><span>🌱</span></span>
        </a>
      </div>
    </div>

    <!-- Side Stack: Latest Dream & Latest Travel -->
    <div class="bento-side-stack">
      {latestDream && (
        <a href={latestDream.url} class="bento-card spotlight-card dream-spot">
          <div>
            <div class="spot-header">
              <span class="spot-badge dream">🌙 最新梦境</span>
              <span>{latestDream.dateFormatted}</span>
            </div>
            <h2 class="spot-title">{latestDream.title}</h2>
            <p class="spot-excerpt">{latestDream.excerpt}</p>
          </div>
          <div style="margin-top:12px;font-size:12px;color:var(--c-dream);font-family:var(--font-mono);">
            潜入梦境 →
          </div>
        </a>
      )}

      {latestTravel && (
        <a href={latestTravel.url} class="bento-card spotlight-card travel-spot">
          <div>
            <div class="spot-header">
              <span class="spot-badge travel">
                🧭 最新远行 {latestTravel.city ? `· ${latestTravel.city.name}` : ''}
              </span>
              <span>{latestTravel.dateFormatted}</span>
            </div>
            <h2 class="spot-title">
              {latestTravel.subtitle ? `${latestTravel.title} · ${latestTravel.subtitle}` : latestTravel.title}
            </h2>
            <p class="spot-excerpt">{latestTravel.excerpt}</p>
          </div>
          <div style="margin-top:12px;font-size:12px;color:var(--c-travel);font-family:var(--font-mono);">
            踏上旅途 →
          </div>
        </a>
      )}
    </div>

    <!-- Full-width Travel Constellation Map & City Wall -->
    <TravelMap cities={citySummaries} compact={true} />
  </section>

  <!-- All Posts Stream with Instant Category Filter -->
  <section id="stream">
    <div class="feed-section-head">
      <h2 class="section-heading">
        <span class="sparkle">✦</span>
        <span>全部篇章</span>
        <span id="visible-count" style="font-family:var(--font-mono);font-size:13px;color:var(--ink-muted);font-weight:400;">
          ({allPosts.length})
        </span>
      </h2>

      <div class="filter-tabs" role="tablist" aria-label="按分类筛选文章">
        <button type="button" class="filter-tab active" data-filter="all">
          全部 <span style="opacity:0.65;font-size:11px;">{allPosts.length}</span>
        </button>
        <button type="button" class="filter-tab" data-filter="dream">
          🌙 梦境 <span style="opacity:0.65;font-size:11px;">{dreams.length}</span>
        </button>
        <button type="button" class="filter-tab" data-filter="travel">
          🧭 游记 <span style="opacity:0.65;font-size:11px;">{travels.length}</span>
        </button>
        <button type="button" class="filter-tab" data-filter="novel">
          🌊 小说 <span style="opacity:0.65;font-size:11px;">{novels.length}</span>
        </button>
        <button type="button" class="filter-tab" data-filter="diary">
          🌱 日记 <span style="opacity:0.65;font-size:11px;">{diaries.length}</span>
        </button>
      </div>
    </div>

    <div class="posts-grid" id="home-posts-grid">
      {allPosts.map((post) => (
        <PostCard post={post} />
      ))}
    </div>
  </section>

  <script is:inline>
    function initHomeFilter() {
      const tabs = document.querySelectorAll('.filter-tab[data-filter]');
      const cards = document.querySelectorAll('#home-posts-grid .post-card');
      const countEl = document.getElementById('visible-count');
      if (!tabs.length || !cards.length) return;

      tabs.forEach((tab) => {
        if (tab.dataset.bound === 'true') return;
        tab.dataset.bound = 'true';
        tab.addEventListener('click', () => {
          const filter = tab.getAttribute('data-filter');
          tabs.forEach((t) => t.classList.remove('active'));
          tab.classList.add('active');

          let visible = 0;
          cards.forEach((card) => {
            const cat = card.getAttribute('data-category');
            const match = filter === 'all' || cat === filter;
            card.classList.toggle('is-hidden', !match);
            if (match) visible++;
          });
          if (countEl) countEl.textContent = `(${visible})`;
        });
      });
    }

    initHomeFilter();
    document.addEventListener('astro:page-load', initHomeFilter);
  </script>
</BaseLayout>
