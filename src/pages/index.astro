---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPosts, getCityStats, CN, CI, hashRot, type PostItem } from '../lib/posts';

const posts = await getPosts();
const cities = getCityStats(posts);
const counts = {
  dream: posts.filter((p) => p.c === 'dream').length,
  travel: posts.filter((p) => p.c === 'travel').length,
  novel: posts.filter((p) => p.c === 'novel').length,
  diary: posts.filter((p) => p.c === 'diary').length,
};
const totalWords = posts.reduce((sum, p) => sum + p.w, 0);
const recent8 = posts.slice(0, 8);

// Group archive posts by YYYY.MM
const monthMap = new Map<string, PostItem[]>();
for (const p of posts) {
  const ym = p.d.slice(0, 7);
  const arr = monthMap.get(ym) ?? [];
  arr.push(p);
  monthMap.set(ym, arr);
}
const months = Array.from(monthMap.entries());
---
<BaseLayout title="梦与远方" description="夜里写下的梦境，白天去过的远方" totalPosts={posts.length}>
  <section id="hero" data-scene="序幕 · 梦与远方">
    <div class="naive-canvas" aria-hidden="true">
      <svg viewBox="0 0 560 176" width="560" height="176" xmlns="http://www.w3.org/2000/svg">
        <!-- Starry night sky & warm horizon -->
        <g class="set-layer" data-layer="sky">
          <rect x="0" y="0" width="560" height="176" rx="12" fill="#355070" />
          <path d="M0,108 Q140,86 290,102 T560,96 L560,176 L0,176 Z" fill="#E8B84B" opacity="0.22" />
        </g>
        <!-- Naive crescent moon & folk stars -->
        <g class="set-layer" data-layer="celestial">
          <path d="M98,28 A26,26 0 1,0 122,64 A20,20 0 1,1 98,28 Z" fill="#F2C14E" stroke="#3A2A1E" stroke-width="2" />
          <path d="M168,36 L172,44 L180,45 L173,50 L175,58 L168,53 L161,58 L163,50 L156,45 L164,44 Z" fill="#FFFDF8" />
          <circle cx="228" cy="28" r="3" fill="#E8B84B" />
          <circle cx="312" cy="40" r="2.5" fill="#FFFDF8" />
          <circle cx="390" cy="24" r="3.5" fill="#E8B84B" />
          <circle cx="486" cy="42" r="2.5" fill="#FFFDF8" />
        </g>
        <!-- Rolling hills & distant sea -->
        <g class="set-layer" data-layer="hills">
          <path d="M0,124 Q95,92 210,120 T420,114 Q490,104 560,120 L560,176 L0,176 Z" fill="#52796F" stroke="#3A2A1E" stroke-width="2" />
          <path d="M0,140 Q130,118 270,136 T560,130 L560,176 L0,176 Z" fill="#C85A32" opacity="0.88" stroke="#3A2A1E" stroke-width="2" />
        </g>
        <!-- Sea waves on right -->
        <g class="set-layer" data-layer="sea">
          <path d="M350,146 Q372,138 394,146 T438,146 T482,146 T526,146 T560,146 L560,176 L340,176 Z" fill="#4A7294" stroke="#3A2A1E" stroke-width="2" />
          <path d="M366,158 Q384,153 402,158 T438,158 T474,158 T510,158" fill="none" stroke="#FFFDF8" stroke-width="2" stroke-linecap="round" opacity="0.8" />
        </g>
        <!-- Small storybook lighthouse -->
        <g class="set-layer" data-layer="lighthouse">
          <path d="M432,142 L438,88 L454,88 L460,142 Z" fill="#FFFDF8" stroke="#3A2A1E" stroke-width="2" />
          <path d="M435,112 L457,112 L458,124 L434,124 Z" fill="#C85A32" />
          <rect x="436" y="76" width="20" height="12" rx="2" fill="#E8B84B" stroke="#3A2A1E" stroke-width="2" />
          <path d="M433,76 L446,64 L459,76 Z" fill="#C85A32" stroke="#3A2A1E" stroke-width="2" />
          <path class="lh-beam" d="M459,80 L515,66 L515,94 Z" fill="#F2C14E" opacity="0.38" />
        </g>
        <!-- Folk botanical trees & flowers on left -->
        <g class="set-layer" data-layer="botanical">
          <path d="M52,158 L52,126" stroke="#3A2A1E" stroke-width="2.5" stroke-linecap="round" />
          <ellipse cx="52" cy="116" rx="18" ry="22" fill="#749E82" stroke="#3A2A1E" stroke-width="2" />
          <path d="M126,162 L126,136" stroke="#3A2A1E" stroke-width="2.5" stroke-linecap="round" />
          <circle cx="126" cy="128" r="14" fill="#E8B84B" stroke="#3A2A1E" stroke-width="2" />
          <circle cx="126" cy="128" r="5" fill="#C85A32" />
          <circle cx="240" cy="148" r="6" fill="#FFFDF8" stroke="#3A2A1E" stroke-width="1.5" />
          <circle cx="240" cy="148" r="2.2" fill="#E8B84B" />
          <circle cx="282" cy="156" r="5" fill="#E8B84B" stroke="#3A2A1E" stroke-width="1.5" />
        </g>
      </svg>
    </div>
    <h1 id="ttl" aria-label="梦与远方">
      <b aria-hidden="true">梦</b>
      <b aria-hidden="true">与</b>
      <b aria-hidden="true">远</b>
      <b aria-hidden="true">方</b>
    </h1>
    <p class="hero-sub"><b class="md-sym" aria-hidden="true">&gt;</b> 夜里写下的梦境，白天去过的远方<span class="orb-slot" data-orb-anchor>。</span></p>
    <div class="hero-cta">
      <button type="button" class="btn o" id="hero-dream-btn">🌙 读一个梦</button>
      <a href="#archive" class="btn on">📚 浏览全部</a>
    </div>
    <div class="badge spin" aria-label={`共 ${posts.length} 篇文章，${cities.length} 座城市`}>
      <span>{posts.length} 篇</span>
      <span>{cities.length} 座城</span>
    </div>
    <div class="scroll-hint" aria-hidden="true">↓ 往下滚</div>
  </section>

  <section id="manifesto-bridge" class="stage-interlude iris-stage" data-scene="01 · 昼夜手记" aria-label="昼夜手记宣言">
    <div class="iris-backdrop" aria-hidden="true"></div>
    <div class="interlude-inner">
      <p class="md-kicker"><b class="md-sym" aria-hidden="true">##</b> what we keep · 留存之物</p>
      <p class="interlude-lead" id="home-lit-text">
        <span class="ln-mask"><span class="ln-in"><span class="md-word">白昼走过的山海</span><span class="md-word">只是表面，</span></span></span>
        <span class="ln-mask"><span class="ln-in"><span class="md-word">夜半醒来的梦境</span><span class="md-word">才是底下的引擎</span><span class="orb-slot" data-orb-anchor>。</span></span></span>
      </p>
      <div class="interlude-beats" aria-label="三个支点">
        <span class="beat-frag"><em class="beat-w">一盏灯塔</em><i class="beat-dot" aria-hidden="true">·</i></span>
        <span class="beat-frag"><em class="beat-w">几座孤岛</em><i class="beat-dot" aria-hidden="true">·</i></span>
        <span class="beat-frag"><em class="beat-w">写给自己的手稿</em><span class="orb-slot" data-orb-anchor>。</span></span>
      </div>
    </div>
  </section>

  <div class="mq" id="mq1" aria-hidden="true">
    <div class="track">
      <div class="chunk">
        {cities.map((c) => (
          <>
            <span>🧭 {c.name} · {c.count}</span>
            <span class="sep"></span>
          </>
        ))}
      </div>
    </div>
  </div>

  <div class="mq alt" aria-hidden="true">
    <div class="track">
      <div class="chunk">
        <span>🌙 梦境 {counts.dream}</span><span class="sep"></span>
        <span>🧭 游记 {counts.travel}</span><span class="sep"></span>
        <span>🌊 小说 {counts.novel}</span><span class="sep"></span>
        <span>🌱 日记 {counts.diary}</span><span class="sep"></span>
        <span>📚 存档 {posts.length} 篇</span><span class="sep"></span>
      </div>
    </div>
  </div>

  <section class="wrap" data-scene="02 · 旅途刻度" aria-label="站点统计">
    <div id="stats">
      <div class="stat rv">
        <div class="n" data-n={posts.length}>{posts.length}</div>
        <div class="l">篇存档</div>
      </div>
      <div class="stat rv" style="transition-delay:80ms">
        <div class="n" data-n={cities.length}>{cities.length}</div>
        <div class="l">座漫游城市</div>
      </div>
      <div class="stat rv" style="transition-delay:160ms">
        <div class="n" data-n={counts.dream}>{counts.dream}</div>
        <div class="l">个夜半梦境</div>
      </div>
      <div class="stat rv" style="transition-delay:240ms">
        <div class="n" data-n={Math.round(totalWords / 1000)}>{Math.round(totalWords / 1000)}</div>
        <div class="l">千字写作</div>
      </div>
    </div>
  </section>

  <section id="hz" data-scene="03 · 最近八篇" aria-label="最近 8 篇文章">
    <div class="pin">
      <div class="hz-head">
        <h2 class="sec sk"><b class="md-sym" aria-hidden="true">##</b> 最近 <em>8</em> 篇 <span class="orb-slot" data-orb-anchor></span></h2>
        <span class="tag">← 横向漫游 →</span>
      </div>
      <div id="rail">
        {recent8.map((p, idx) => (
          <a href={p.u} class="hc">
            <div class="hc-top">
              <span class="hc-num">{String(idx + 1).padStart(2, '0')}</span>
              <span class={`tag ${p.c}`}>{CI[p.c]} {CN[p.c]}</span>
            </div>
            <div>
              <h3>{p.t}</h3>
              {p.st && <p style="margin-top:6px;font-weight:800;">{p.st}</p>}
              <p style="margin-top:10px;">{p.ex.slice(0, 72)}{p.ex.length > 72 ? '…' : ''}</p>
            </div>
            <div class="hc-foot">
              <span>{p.d}</span>
              <span>{p.loc || `${p.w} 字`}</span>
            </div>
          </a>
        ))}
      </div>
      <div class="hz-prog" aria-hidden="true">
        <div id="hzb"></div>
      </div>
    </div>
  </section>

  <section id="cities" class="wrap iris-stage" style="max-width:none;padding:96px 24px;" data-scene="04 · 漫游城邦" aria-label="漫游城市">
    <div class="iris-backdrop cities-iris" aria-hidden="true"></div>
    <div style="max-width:1220px;margin:0 auto;position:relative;z-index:1;">
      <h2 class="sec sk"><b class="md-sym" aria-hidden="true">##</b> {cities.length} 座城，<em>{counts.travel}</em> 场远行 <span class="orb-slot" data-orb-anchor></span></h2>
      <div id="cloud">
        {cities.map((c, i) => (
          <button
            type="button"
            class="city rv"
            data-city={c.name}
            aria-pressed="false"
            style={`font-size:${18 + c.count * 6}px;--rot:${hashRot(c.name)}deg;transition-delay:${i * 40}ms`}
          >
            {c.name}<sup>{c.count}</sup>
          </button>
        ))}
      </div>
    </div>
  </section>

  <section id="archive" class="wrap" data-scene="05 · 记忆归档" aria-label="文章归档">
    <h2 class="sec sk"><b class="md-sym" aria-hidden="true">##</b> 全部 <em>归档</em> <span class="orb-slot" data-orb-anchor></span></h2>

    <div class="tools">
      <div class="filters" role="group" aria-label="分类筛选">
        <button type="button" class="btn on" data-cat="all" aria-pressed="true">全部 ({posts.length})</button>
        <button type="button" class="btn" data-cat="dream" aria-pressed="false">🌙 梦境 ({counts.dream})</button>
        <button type="button" class="btn" data-cat="travel" aria-pressed="false">🧭 游记 ({counts.travel})</button>
        <button type="button" class="btn" data-cat="novel" aria-pressed="false">🌊 小说 ({counts.novel})</button>
        <button type="button" class="btn" data-cat="diary" aria-pressed="false">🌱 日记 ({counts.diary})</button>
      </div>
      <div class="search-wrap">
        <input
          id="q"
          type="search"
          placeholder="搜索标题 / 摘要 / 地点（按 / 聚焦）"
          aria-label="搜索文章"
          autocomplete="off"
        />
        <span id="cnt" aria-live="polite">{posts.length} / {posts.length} 篇</span>
      </div>
    </div>

    <div id="list">
      {months.map(([ym, items]) => (
        <div class="month-group" data-ym={ym}>
          <div class="month">
            <span class="month-big">{ym}</span>
            <span class="month-tag">{items.length} 篇</span>
          </div>
          <div class="grid">
            {items.map((p, idx) => (
              <a
                href={p.u}
                class="card rv"
                data-c={p.c}
                data-city={p.city}
                data-q={`${p.t} ${p.st} ${p.ex} ${p.loc}`}
                data-title={p.t}
                data-st={p.st}
                data-ex={p.ex.slice(0, 80)}
                style={`--rot:${p.rot}deg;transition-delay:${(idx % 4) * 70}ms;--vt-name:card-${p.u.replace(/[^a-zA-Z0-9_-]/g, '-')}`}
              >
                <div class="card-top">
                  <span class={`tag ${p.c}`}>{CI[p.c]} {CN[p.c]}</span>
                  {p.loc && <span class="tag">{p.loc}</span>}
                </div>
                <div>
                  <h3 class="card-title">{p.t}</h3>
                  {p.st && <p class="st card-st">{p.st}</p>}
                  <p class="ex card-ex" style="margin-top:8px;">{p.ex.slice(0, 80)}{p.ex.length > 80 ? '…' : ''}</p>
                </div>
                <div class="card-foot">
                  <span>{p.d}</span>
                  <span>{p.w} 字</span>
                </div>
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>

    <div id="empty" hidden>没有找到匹配的文章 ✦ 换个关键词或分类试试</div>
  </section>

  <script>
    import '../scripts/home.js';
  </script>
</BaseLayout>
