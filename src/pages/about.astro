---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPosts, getCityStats } from '../lib/posts';

const posts = await getPosts();
const cities = getCityStats(posts);
const counts = {
  dream: posts.filter((p) => p.c === 'dream').length,
  travel: posts.filter((p) => p.c === 'travel').length,
  novel: posts.filter((p) => p.c === 'novel').length,
  diary: posts.filter((p) => p.c === 'diary').length,
};

const fillText =
  '这里是一个写给自己看的角落。白天去远方，夜里做奇怪又温柔的梦。梦境是凌晨醒来随手记下的微光，游记是把去过的山海与古镇留在纸上，小说是在讲一个关于灯塔、海底城和母亲的故事，日记是田里的草木和心里的话。没有宏大的目的，只是不想让那些转瞬即逝的星群就这么散掉。';
const keywords = ['梦境', '游记', '小说', '日记', '山海', '灯塔', '星群', '角落'];

// Precompute which character indices belong to keywords
const hlFlags = new Array(fillText.length).fill(false);
for (const kw of keywords) {
  let idx = fillText.indexOf(kw);
  while (idx !== -1) {
    for (let k = 0; k < kw.length; k++) hlFlags[idx + k] = true;
    idx = fillText.indexOf(kw, idx + kw.length);
  }
}
const chars = [...fillText];
---
<BaseLayout title="关于" description="关于梦与远方 · 写给自己看的角落" totalPosts={posts.length}>
  <section class="ahero" data-scene="序幕 · 关于">
    <div class="about-stage" aria-hidden="true">
      <svg viewBox="0 0 420 156" width="420" height="156" xmlns="http://www.w3.org/2000/svg">
        <!-- Window looking out to night sea -->
        <g class="set-layer" data-layer="window">
          <rect x="20" y="14" width="168" height="104" rx="10" fill="#355070" stroke="#3A2A1E" stroke-width="2.5" />
          <path d="M22,86 Q64,74 106,86 T186,84 L186,116 L22,116 Z" fill="#4A7294" stroke="#3A2A1E" stroke-width="2" />
          <path d="M52,32 A14,14 0 1,0 66,52 A11,11 0 1,1 52,32 Z" fill="#F2C14E" stroke="#3A2A1E" stroke-width="1.8" />
          <circle cx="96" cy="34" r="2.2" fill="#FFFDF8" />
          <circle cx="158" cy="28" r="2.5" fill="#E8B84B" />
          <line x1="104" y1="14" x2="104" y2="118" stroke="#FFFDF8" stroke-width="2.5" />
          <line x1="20" y1="68" x2="188" y2="68" stroke="#FFFDF8" stroke-width="2.5" />
        </g>
        <!-- Distant lighthouse & beam outside window -->
        <g class="set-layer" data-layer="lighthouse">
          <path d="M138,94 L142,60 L152,60 L156,94 Z" fill="#FFFDF8" stroke="#3A2A1E" stroke-width="1.8" />
          <rect x="141" y="52" width="12" height="8" rx="1.5" fill="#E8B84B" stroke="#3A2A1E" stroke-width="1.8" />
          <path d="M139,52 L147,44 L155,52 Z" fill="#C85A32" stroke="#3A2A1E" stroke-width="1.8" />
          <path class="lh-beam" d="M153,55 L186,44 L186,66 Z" fill="#F2C14E" opacity="0.4" />
        </g>
        <!-- Wooden desk & open ABOUT.md notebook -->
        <g class="set-layer" data-layer="desk">
          <rect x="14" y="122" width="392" height="22" rx="8" fill="#EFE3CE" stroke="#3A2A1E" stroke-width="2.5" />
          <path d="M214,126 L278,108 L338,116 L274,134 Z" fill="#FFFDF8" stroke="#3A2A1E" stroke-width="2" />
          <path d="M244,121 L294,114" stroke="#C85A32" stroke-width="2" stroke-linecap="round" />
          <path d="M250,126 L298,119" stroke="#3A2A1E" stroke-width="1.6" stroke-linecap="round" opacity="0.6" />
          <text x="234" y="102" font-family="monospace" font-size="11" font-weight="700" fill="#3A2A1E">ABOUT.md</text>
        </g>
        <!-- Warm coffee mug & animated steam -->
        <g class="set-layer" data-layer="mug">
          <rect x="348" y="92" width="32" height="32" rx="6" fill="#C85A32" stroke="#3A2A1E" stroke-width="2.2" />
          <path d="M380,99 C391,99 391,117 380,117" fill="none" stroke="#3A2A1E" stroke-width="2.2" stroke-linecap="round" />
          <circle cx="364" cy="108" r="5" fill="#E8B84B" stroke="#3A2A1E" stroke-width="1.5" />
          <path class="steam" d="M357,86 C353,76 363,70 358,58" fill="none" stroke="#52796F" stroke-width="2.2" stroke-linecap="round" />
          <path class="steam" d="M369,86 C373,75 363,68 369,55" fill="none" stroke="#C85A32" stroke-width="2.2" stroke-linecap="round" />
        </g>
      </svg>
    </div>
    <h1 class="ahero-words" aria-label="关于">
      <b id="ab-a" aria-hidden="true">关</b>
      <span class="ahero-dot orb-slot" data-orb-anchor aria-hidden="true"></span>
      <b id="ab-b" aria-hidden="true">于</b>
    </h1>
    <div class="ahero-meta">
      <span class="tag dream">{posts.length} 篇存档</span>
      <span class="tag travel">{cities.length} 座城市</span>
      <span class="tag diary">Astro 纯静态</span>
    </div>
    <blockquote class="md-quote">
      <p><b class="md-sym" aria-hidden="true">&gt;</b> a working manifesto. 写给自己的夜间备忘。</p>
      <p><b class="md-sym" aria-hidden="true">&gt;</b> 不是宏大叙事，只是凌晨三点与白昼远行的索引。</p>
    </blockquote>
  </section>

  <section class="fill" data-scene="01 · 站点自白" aria-label="站点自白">
    <p class="md-kicker"><b class="md-sym" aria-hidden="true">##</b> 01 · what this place is / 站点自白 <span class="orb-slot" data-orb-anchor></span></p>
    <p id="fp" aria-label={fillText}>
      {chars.map((ch, i) => (
        <span aria-hidden="true" class={hlFlags[i] ? 'hl' : undefined}>{ch}</span>
      ))}
    </p>
  </section>

  <section class="stack" data-scene="02 · 四个抽屉" aria-label="四个分类">
    <h2 class="sec sk stack-sec"><b class="md-sym" aria-hidden="true">##</b> 四个 <em>抽屉</em> <span class="orb-slot" data-orb-anchor></span></h2>
    <article class="sc">
      <div class="sc-head">
        <h3><b class="md-sym" aria-hidden="true">### 01</b> 🌙 梦境</h3>
        <span class="sc-cnt">{counts.dream} 篇</span>
      </div>
      <p>凌晨三点醒来，趁着细节还没散去，把那些荒诞、失重又莫名温柔的画面匆忙记下来。</p>
    </article>

    <article class="sc">
      <div class="sc-head">
        <h3><b class="md-sym" aria-hidden="true">### 02</b> 🧭 游记</h3>
        <span class="sc-cnt">{counts.travel} 篇</span>
      </div>
      <p>走过 {cities.length} 座城，淋过不同的雨。把青石板路、风声和陌生的烟火气留作路标。</p>
    </article>

    <article class="sc">
      <div class="sc-head">
        <h3><b class="md-sym" aria-hidden="true">### 03</b> 🌊 小说</h3>
        <span class="sc-cnt">{counts.novel} 章</span>
      </div>
      <p>关于灯塔、海底城与漫长潮汐的连载。在虚构的水面之下，藏着比现实更诚实的回响。</p>
    </article>

    <article class="sc">
      <div class="sc-head">
        <h3><b class="md-sym" aria-hidden="true">### 04</b> 🌱 日记</h3>
        <span class="sc-cnt">{counts.diary} 篇</span>
      </div>
      <p>菜园里的甲虫、屋檐下的雨声，和那些不想被时间轻易抹掉的寻常时刻。</p>
    </article>
  </section>

  <section id="about-manifesto" class="wrap iris-stage" data-scene="03 · 创作者备忘" aria-label="创作者备忘">
    <div class="iris-backdrop manifesto-iris" aria-hidden="true"></div>
    <div class="manifesto-inner">
      <h2 class="sec sk"><b class="md-sym" aria-hidden="true">##</b> 创作者 <em>备忘</em> <span class="orb-slot" data-orb-anchor></span></h2>
      <div class="manifesto-grid">
        <article class="manifesto-card less rv">
          <p class="md-kicker"><b class="md-sym" aria-hidden="true">###</b> trying to stop · 试着少做</p>
          <ul>
            <li>等到一切“准备周全”才肯落笔</li>
            <li>只在脑海里反复涂改，却不在纸上留痕</li>
            <li>把旅途拍成千篇一律的风景明信片</li>
            <li>假装凌晨三点的荒诞梦境毫无意义</li>
          </ul>
        </article>
        <article class="manifesto-card more rv" style="transition-delay:100ms">
          <p class="md-kicker"><b class="md-sym" aria-hidden="true">###</b> trying to do more · 试着多做</p>
          <ul>
            <li>先把粗糙但诚实的第一稿写完</li>
            <li>记下刚醒来那五分钟还没散去的微光</li>
            <li>去念不出名字的小城看老菜单背面</li>
            <li>为十年后的自己留下一座纸上灯塔</li>
          </ul>
        </article>
      </div>
      <p class="manifesto-sign">
        <b class="md-sym" aria-hidden="true">—</b> last touched at the desk, late night <span class="orb-slot" data-orb-anchor>.</span>
      </p>
    </div>
  </section>

  <div class="about-cta">
    <a href="/#archive" class="btn on" style="font-size:20px;padding:16px 32px;">📚 去归档里逛逛 →</a>
  </div>

  <script>
    import '../scripts/about.js';
  </script>
</BaseLayout>
