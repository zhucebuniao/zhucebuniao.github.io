---
import '../styles/brutal.css';
import { getPosts } from '../lib/posts';

interface Props {
  title?: string;
  description?: string;
  totalPosts?: number;
}

const {
  title = '梦与远方',
  description = '夜里写下的梦境，白天去过的远方',
  totalPosts,
} = Astro.props;

const postCount = totalPosts ?? (await getPosts()).length;
const pathname = Astro.url.pathname;
const fullTitle = title === '梦与远方' ? '梦与远方 · 稚拙手账' : `${title} · 梦与远方`;
---
<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🌙</text></svg>" />
  <link rel="alternate" type="application/rss+xml" title="梦与远方 RSS" href="/rss.xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Ma+Shan+Zheng&family=Noto+Serif+SC:wght@400;600;700&family=ZCOOL+XiaoWei&display=swap" />
  <script is:inline>
    window.SCROLL_HOOKS = [];
    window.RM = matchMedia('(prefers-reduced-motion: reduce)').matches;
    (function () {
      try {
        var fs = localStorage.getItem('fs');
        var fsMap = { '17': '1.0625rem', '19': '1.1875rem', '22': '1.375rem' };
        if (fs && fsMap[fs]) {
          document.documentElement.style.setProperty('--fs', fsMap[fs]);
        }
      } catch (e) {}
    })();
  </script>
</head>
<body>
  <a href="#main" class="skip">跳到正文</a>
  <svg width="0" height="0" aria-hidden="true" style="position:absolute;pointer-events:none">
    <defs>
      <filter id="naive-sketch">
        <feTurbulence type="fractalNoise" baseFrequency="0.035" numOctaves="2" result="noise" />
        <feDisplacementMap in="SourceGraphic" in2="noise" scale="2.2" />
      </filter>
    </defs>
  </svg>
  <div id="bar" aria-hidden="true"></div>
  <div id="cur" aria-hidden="true"><span>看 ✦</span></div>

  <nav class="nav" aria-label="主导航">
    <a href="/" class="brand">
      <span class="brand-mark" aria-hidden="true">🌙</span>
      <span>梦与远方</span>
    </a>
    <div class="nav-links">
      <a href="/" class={`btn ${pathname === '/' ? 'on' : ''}`}>首页</a>
      <a href="/#archive" class="btn">归档</a>
      <a href="/about/" class={`btn ${pathname.startsWith('/about') ? 'on' : ''}`}>关于</a>
    </div>
  </nav>

  <main id="main">
    <slot />
  </main>

  <footer>
    <div id="bye" aria-hidden="true">✦ 晚安，远方 · GOODNIGHT, FAR AWAY · 晚安，远方 ✦</div>
    <div class="foot-meta">
      <span>🌙 梦与远方 · 共 {postCount} 篇 · 夜里写下的梦，白天去过的地方</span>
      <div class="foot-links">
        <a href="/">首页</a>
        <a href="/#archive">归档</a>
        <a href="/about/">关于</a>
        <a href="/rss.xml">RSS</a>
      </div>
    </div>
  </footer>

  <script>
    import '../scripts/app.js';
  </script>
</body>
</html>
