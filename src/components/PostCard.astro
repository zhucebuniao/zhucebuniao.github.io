---
import type { EnrichedPost } from '../utils/posts';

interface Props {
  post: EnrichedPost;
}

const { post } = Astro.props;
---
<a
  href={post.url}
  class="bento-card post-card"
  data-category={post.category}
  data-city={post.city?.name || ''}
>
  <div>
    <div class="post-card-top">
      <div style="display:flex;align-items:center;gap:6px;flex-wrap:wrap;">
        <span class={`cat-pill ${post.category}`}>
          <span>{post.categoryMeta.icon}</span>
          <span>{post.categoryMeta.label}</span>
        </span>
        {post.city && (
          <span class="cat-pill travel" style="background:rgba(255,255,255,0.04);color:var(--ink-secondary);">
            📍 {post.city. province} · {post.city.name}
          </span>
        )}
      </div>
      <span class="post-meta-line">{post.dateFormatted}</span>
    </div>

    <h3
      class="post-card-title"
      style="margin-top:12px;"
      transition:name={`title-${post.id}`}
    >
      {post.title}
    </h3>

    {post.subtitle && (
      <div class="post-card-subtitle">{post.subtitle}</div>
    )}

    <p class="post-card-excerpt">{post.excerpt}</p>
  </div>

  <div class="post-card-footer">
    <span>{post.wordCount} 字 · 约 {post.readingMinutes} 分钟</span>
    <span class="read-more-arrow">阅读全文 →</span>
  </div>
</a>
